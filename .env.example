# 复制为 .env.local 后填写。仅服务端读取，不会打进前端产物。
# 文案接口无 Key 时可返回演示文案；真实图片生成需要单独配置百炼 Key。
DEEPSEEK_API_KEY=

# 可选。默认 deepseek-flash（DeepSeek V4.1-Flash），一般不用改。
# DEEPSEEK_MODEL=deepseek-flash

# 阿里云百炼千问生图；与 DeepSeek 的文案密钥分开配置，仅服务端读取。
DASHSCOPE_API_KEY=
# DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
# Q 版头像使用 Pro 模型以增强造型与参考图的一致性。
# DASHSCOPE_AVATAR_MODEL=qwen-image-2.0-pro
# 默认使用华北2（北京）；其他地域需使用匹配的密钥和接口域名。
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
